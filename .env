# ==========================================
# CLOUDFLARE PAGES - ENVIRONMENT VARIABLES
# ==========================================
# Fill in the values for your specific client/setup and upload 
# this file using the "Import .env" button in Cloudflare.

# ------------------------------------------
# 0. SITE TEMPLATE / VERSION SELECTION
# ------------------------------------------
# TEMPLATE_VERSION: Select which homepage layout version to display.
# Allowed values: "v1" (Classic Layout) OR "v2" (Modern Tailwind Layout)
# Default: "v1"
TEMPLATE_VERSION="v1"

# BRAND_COLORS: JSON code generated from Admin Theme Customizer (/admin/theme.html)
# Example: '{"primary":"#8B1A1A","primary_light":"#B03535","primary_dark":"#680000","bg":"#ffffff","text_dark":"#1a0808"}'
BRAND_COLORS=""

# ------------------------------------------
# 1. CORE & DATABASE SETTINGS
# ------------------------------------------
# DB_PROVIDER: Which database system to use.
# Allowed values: "cf_db" (for Cloudflare D1) OR "appwrite"
DB_PROVIDER="cf_db"

# JWT_SECRET: A strong random string for encrypting user sessions.
# Example: "any_random_string_like_1234abcd"
JWT_SECRET=""

# WEBHOOK_SECRET: Secret key for verifying webhooks (Optional)
WEBHOOK_SECRET=""

# REVALIDATE_SECRET: Secret key to clear/purge frontend cache via API.
REVALIDATE_SECRET=""

# ------------------------------------------
# 2. ADMIN CREDENTIALS
# ------------------------------------------
# Default login credentials for the Admin Panel
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="admin123"

# ADMIN_SECRET_TOKEN: Required for secure admin API operations.
# Example: "secret_admin_token_2026"
ADMIN_SECRET_TOKEN=""

# ------------------------------------------
# 3. CLOUDFLARE API & CACHE PURGING (REQUIRED)
# ------------------------------------------
# Used to automatically clear cache when you update products/settings.
# CLOUDFLARE_ZONE_ID: Found on your Cloudflare dashboard (Overview page, right sidebar).
CLOUDFLARE_ZONE_ID=""
# CLOUDFLARE_API_TOKEN: Create from "My Profile" -> "API Tokens" (Needs "Cache Purge" permission).
CLOUDFLARE_API_TOKEN=""

# ------------------------------------------
# 4. EXTERNAL D1 DATABASE (NOT REQUIRED FOR CLOUDFLARE PAGES)
# ------------------------------------------
# 🛑 IGNORE THESE if you are hosting on Cloudflare Pages and using D1 Database Bindings.
# These are ONLY needed if you host your backend externally (e.g., Vercel, Node.js).
CF_ACCOUNT_ID=""
CF_DB_ID=""
CF_D1_TOKEN=""
CF_D1_READ_TOKEN=""
CF_API_TOKEN=""
CF_ZONE_ID=""

# ------------------------------------------
# 5. SUPABASE SETTINGS (NOT REQUIRED IF USING D1)
# ------------------------------------------
# 🛑 IGNORE THESE if DB_PROVIDER="cf_db"
SUPABASE_URL=""
SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

# ------------------------------------------
# 6. STORAGE & MEDIA (R2)
# ------------------------------------------
# The public custom domain for your Cloudflare R2 bucket.
# Example: "https://media.yourdomain.com"
R2_PUBLIC_URL=""

# ------------------------------------------
# 7. THIRD-PARTY APIs & TRACKING
# ------------------------------------------
# Google Analytics 4 API Secret
GA4_API_SECRET=""
# Meta (Facebook) Graph API Token
META_API_TOKEN=""
# Vercel deployment URL (if part of backend is on Vercel)
VERCEL_API_BASE=""

# Tawk.to Live Chat Widget URL (Optional)
# Example: "https://embed.tawk.to/YOUR_ID/YOUR_WIDGET_ID"
TAWK_WIDGET_URL=""

# ------------------------------------------
# 8. GITHUB INTEGRATION
# ------------------------------------------
# For automatically triggering deployments or updates to GitHub.
# GITHUB_OWNER: Your GitHub username (e.g., "rifat16700")
GITHUB_OWNER=""
# GITHUB_REPO: Repository name (e.g., "freelancingbyrifat")
GITHUB_REPO=""
# GITHUB_TOKEN: Personal Access Token (PAT) with repo access.
GITHUB_TOKEN=""
